// Copy to Local.xcconfig (ignored by git).

// Your Apple Developer team, for running on a real iPhone and Apple Watch (Xcode › Settings › Accounts).
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// For "Code" (Naar horloge). Both values are public; never put a service_role key here.
// xcconfig treats // as a comment, hence the $() in the address.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
